# Telegram Bot
BOT_TOKEN=your_telegram_bot_token

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Stratz API
STRATZ_TOKEN=your_stratz_bearer_token

# Steam Web API (для resolve vanity URL)
STEAM_API_KEY=your_steam_api_key

# OpenDota API
OPENDOTA_BASE_URL=https://api.opendota.com/api

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key

# AgentPlatform.ru (OpenAI-compatible proxy, works from Russia)
# AGENT_PLATFORM_API=ap_xxx
# LLM_PROVIDER=agentplatform  # uncomment to use AgentPlatform

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
